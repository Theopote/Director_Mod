{
	"schemaVersion": 1,
	"id": "director",
	"version": "${version}",
	"name": "Director",
	"description": "A single-player cinematic toolkit for Minecraft with camera paths, actor animation, scene composition, and a non-linear timeline.",
	"authors": [
		"Director Team"
	],
	"contact": {
		"homepage": "https://github.com/Director/director",
		"sources": "https://github.com/Director/director",
		"issues": "https://github.com/Director/director/issues"
	},
	"license": "Apache-2.0",
	"icon": "assets/director/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.director.DirectorMod"
		],
		"client": [
			"com.director.client.DirectorClient"
		],
		"fabric-datagen": [
			"com.director.DirectorDataGenerator"
		]
	},
	"mixins": [
		{
			"config": "director.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": ">=0.138.4"
	},
	"suggests": {
		"modmenu": ">=4.0.0",
		"jei": ">=12.0.0",
		"wthit": ">=5.0.0"
	},
	"breaks": {
		"optifabric": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/director",
				"modmenu.wiki": "https://github.com/Director/director/wiki"
			},
			"badges": [
				"library"
			]
		},
		"compatibility": {
			"minecraft": {
				"min": "1.21.0",
				"max": "1.21.10",
				"recommended": "1.21.10"
			},
			"fabric": {
				"min": "0.138.4",
				"recommended": "0.138.4+1.21.10"
			},
			"java": {
				"min": "21",
				"recommended": "21"
			},
			"memory": {
				"recommendedJvmHeap": "8G",
				"recommendedJvmArgs": "-Xmx8G -Xms2G"
			}
		},
		"features": [
			"Camera Path Editing",
			"Actor Animation",
			"Non-linear Timeline",
			"Scene Containers",
			"3D Visualization",
			"Video Export"
		]
	}
}
