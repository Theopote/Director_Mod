  "gui.director.properties.clip_ui.sequence.raster_zigzag_tooltip": "Row 1 left-to-right, row 2 right-to-left, like a printer carriage.",
  "gui.director.properties.clip_ui.sequence.flood_seed_header": "Flood Seed",
  "gui.director.properties.clip_ui.sequence.flood_seed_tooltip": "Flood spread start per layer:\n• Layer center: from slice geometric center\n• Layer min corner: from slice (minX,minY,minZ)\n• Layer random: random block per layer\n• Global random: one random point for whole container",
  "gui.director.properties.clip_ui.sequence.weight_header": "4. Layer Separation & Modifiers",
