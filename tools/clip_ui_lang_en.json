  "gui.director.properties.clip_ui.sequence.origin_tooltip_cylindrical_demolition": "Cylindrical origin options (demolition):\n• Top center: spread down from top\n• Geometric center: spread outward from center",
  "gui.director.properties.clip_ui.sequence.origin_tooltip_cylindrical_build": "Cylindrical origin options:\n• Bottom center: spread from ground center\n• Geometric center: spread from overall center",
  "gui.director.properties.clip_ui.sequence.origin_tooltip_demolition": "Sequence start point (demolition, opposite to container):\n• Min corner: from container origin (usually a corner)\n• Geometric center: outward from center\n• Bottom center: from ground up (container clips)\n• Top center: from top down (recommended for demolition)\n• Custom: from your coordinates\n\nTip: demolition is opposite to container, e.g. container bottom-up, demolition top-down.\nTop center is recommended for demolition clips.",
  "gui.director.properties.clip_ui.sequence.origin_tooltip_build": "Sequence start point:\n• Min corner: from container origin (usually a corner)\n• Geometric center: outward from center\n• Bottom center: from ground up; good for trees/buildings\n• Custom: from your coordinates",
  "gui.director.properties.clip_ui.sequence.custom_coords": "Custom Coordinates (XYZ)",
  "gui.director.properties.clip_ui.sequence.fill_header": "3. Fill",
  "gui.director.properties.clip_ui.sequence.fill_tooltip": "Fill path inside each slice:\n• Linear scan: row by row like a printer\n• Raster: rows then in-row; supports zigzag\n• Radial: from slice center outward\n• Spiral: circles around center\n• Smooth noise: Perlin noise; natural chunks\n• Flood: BFS from seed; fire/vine/growth feel",
  "gui.director.properties.clip_ui.sequence.raster_settings": "Raster Scan Settings",
